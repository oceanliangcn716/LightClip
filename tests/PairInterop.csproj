<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="PairInterop.cs" />
    <Compile Include="../windows/PairingCrypto.cs" Link="PairingCrypto.cs" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../windows/native/lightclip_pairing.dll" Link="lightclip_pairing.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('../windows/native/lightclip_pairing.dll')" />
  </ItemGroup>
</Project>
